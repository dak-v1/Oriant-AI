# ── Margo provider keys ──────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# Every key is OPTIONAL: any provider left blank runs in "fixture" mode and is
# honestly labeled as such in the UI and the provider trace. All keys stay
# server-side — they are never sent to the browser or embedded in generated files.

# AI& — reasoning + structured outputs (OpenAI-compatible chat completions).
# Used for: company-report generation, workforce planning, NL plan changes.
# Base URL + model id come from your AI& console (model access is org-specific).
AIAND_API_KEY=
AIAND_BASE_URL=
AIAND_MODEL=

# Supabase — Role A onboarding persistence, org membership, auditability and
# uploaded onboarding assets. Keep the service role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nosana — GPU-hosted Whisper speech recognition.
# NOSANA_WHISPER_URL is the service URL you get AFTER deploying a Nosana job
# (a deployment output, not a model name).
#
# IMPORTANT: it must be a job that SERVES AN HTTP ASR API — Margo posts
# multipart audio (tries the exact URL, then <url>/v1/audio/transcriptions)
# and expects JSON with a `text` field. A Jupyter/notebook-style template
# will answer with an HTML page and 403; Margo now detects that and says so.
# Look for a whisper *server* image (e.g. one exposing an OpenAI-compatible
# /v1/audio/transcriptions endpoint) rather than a notebook environment.
#
# This only powers transcribing YOUR answers. Margo's own speaking voice is
# the browser's Web Speech API and needs no key.
NOSANA_WHISPER_URL=
NOSANA_API_KEY=

# ElevenLabs — preferred future voice-agent adapter for multilingual onboarding.
# Keep server-side; do not expose in the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Doubleword — async/batch OpenAI-compatible inference.
# Used for: asynchronous agent-package generation (one job per agent).
# If your org console shows different async endpoint paths, adjust the two
# constants at the top of lib/server/providers/doubleword.ts.
DOUBLEWORD_API_KEY=
DOUBLEWORD_BASE_URL=
DOUBLEWORD_MODEL=

# Daytona — isolated sandboxes for artifact validation.
# DAYTONA_API_URL defaults to https://app.daytona.io/api
DAYTONA_API_KEY=
DAYTONA_API_URL=
